# TEMPLATE ONLY. Supply these through the process environment / secret manager.
# The cloud entry point does not automatically load dotenv files.
CLOUD_DEV=1
CLOUD_ORIGIN=http://127.0.0.1:8090
CLOUD_PORT=8090
# Production beta admission: comma-separated numeric Twitch user IDs.
# Empty denies all production logins. Development remains local-only.
CLOUD_ALLOWED_USERS=
# Twitch numeric user ID whose Community Count receives Viewer contributions.
# Leave empty until the streamer has logged in once on this database.
CLOUD_COMMUNITY_OWNER_ID=
CLOUD_COMMUNITY_TIMEZONE=America/Los_Angeles
# Use a separate confidential Twitch web application, not the local public app.
# Register exactly: http://127.0.0.1:8090/auth/callback
CLOUD_TWITCH_CLIENT_ID=
CLOUD_TWITCH_CLIENT_SECRET=
# Generate ONCE with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key outside the DB, back it up securely, and never commit it.
CLOUD_ENCRYPTION_KEY=
CLOUD_DATABASE=.cloud-data/cloud.sqlite3
# Production timer only: existing absolute directory, owned by the service user
# with mode 0700. Keep encrypted off-host copies separately.
CLOUD_BACKUP_DIRECTORY=
CLOUD_BACKUP_RETENTION_DAYS=7
# Off by default. Requires CLOUD_DEV=0, public HTTPS origin on port 443,
# a reverse proxy, and an updated Twitch OAuth redirect URI. See docs/CLOUD.md.
CLOUD_ENABLE_EVENTS=0
# Stable random receiver secret: 32-100 ASCII characters; never commit the real value.
CLOUD_EVENTSUB_SECRET=
