.venv/
__pycache__/
*.pyc
.test-data/
.cloud-data/

# Local environment variables (sanitized templates may be committed).
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.cloud.example

# Runtime data may contain OAuth tokens, provider credentials and viewer history.
# Applies even when SQUAT_CAPTURE_DATA_DIR points inside this repository.
.squat-capture/
config.json
stats.json
config.json.*
stats.json.*
!config.json.example
!config.json.sample
!config.json.template

# Local private keys and credential bundles. Never commit real credentials.
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
